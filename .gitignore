# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
/coverage
# next.js
/.next/
/out/
# production
/build
# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files (can opt-in for committing if needed)
.env*
!.env.example
# local object storage
/storage
# prisma
prisma/dev.db
# vercel
.vercel
# typescript
*.tsbuildinfo
next-env.d.ts

# managed by open-wa
**.data.json
**.node-persist**
**_IGNORE_**
# end managed by open-wa

# migration bundle artifacts (rebuilt, never source of truth)
/gatti-crm-source.zip

# db dumps taken by windows/update.bat
/backups

# service-account keys and similar — never committed
/secrets/*
!/secrets/.gitkeep

# unattended update log
/logs

# design-hook scratch cache — rewritten on every edit, no value in history
.impeccable/hook.cache.json

# Written by the update scripts so the running build can report its own
# commit at /version.txt. Generated per machine, never committed.
public/version.txt
