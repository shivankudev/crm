# Order matters: later patterns win, so the catch-all goes first and the
# Windows-specific overrides follow it.

# Everything is LF so the Linux containers see what the Mac wrote.
* text=auto eol=lf

# Batch files are the exception — Windows needs CRLF, or `goto` labels can
# fail to resolve on some builds.
*.bat text eol=crlf
*.cmd text eol=crlf
