# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Used directly when running `npm run dev` on the host.
# docker-compose.yml overrides this to point at the "postgres" service
# for the web/worker/migrate containers — POSTGRES_* below feed that.
DATABASE_URL="postgresql://gatti_crm:gatti_dev_pw@localhost:5432/gatti_crm_dev?schema=public"
POSTGRES_USER="gatti_crm"
POSTGRES_PASSWORD="gatti_dev_pw"
POSTGRES_DB="gatti_crm_dev"

# ---------------------------------------------------------------
# Redis (BullMQ job queue)
# ---------------------------------------------------------------
# docker-compose.yml overrides this to "redis://redis:6379" for containers.
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------
# Set this to a long random string in production: `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-random-32-byte-secret"
# "true" only behind HTTPS
SESSION_COOKIE_SECURE="false"

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Seed data (prisma/seed.ts) — first Super Admin login.
# Change this password immediately after first login.
# ---------------------------------------------------------------
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="admin@gatti-erickshaw.local"
SEED_SUPER_ADMIN_PASSWORD="change-me-immediately"

# ---------------------------------------------------------------
# Object storage (dealer docs / factory-visit photos) — Phase 2+
# ---------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
# S3 / MinIO compatible (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# --- Google Sheets lead import (optional) -------------------------------
# Only needed for "Private sheet" sources. A sheet published to the web
# needs nothing here.
#
# Either paste the whole service-account JSON on one line...
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# ...or mount the key file and point at it (preferred in Docker — keeps the
# key out of the environment listing).
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-service-account.json
